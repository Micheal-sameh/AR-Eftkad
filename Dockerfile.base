# syntax=docker/dockerfile:1

# Base image for the app: php-fpm + nginx + supervisor + pdo_mysql.
#
# Split out of the main Dockerfile so the app build stays fast. It is built once by the
# `base` service in docker-compose.yml and then served from the local image store / cache;
# rebuild it only when the PHP version below changes.
#
# pdo_mysql is the one extension that is not in the php image. Compiling it needs a ~150 MB
# toolchain that takes 10+ minutes to download on our server, so the module is committed
# prebuilt in docker/php/ext/pdo_mysql.so (about 34 KB). It must come from the SAME php
# version as the FROM line below - the `php -m` check fails the build if it does not load.
#
# To regenerate it (e.g. after changing the PHP version):
#   docker run --rm -v "$PWD/docker/php/ext:/out" php:8.2.35-fpm-alpine sh -c \
#     'apk add --no-cache $PHPIZE_DEPS && docker-php-ext-install pdo_mysql \
#      && cp "$(php-config --extension-dir)/pdo_mysql.so" /out/'
FROM php:8.2.35-fpm-alpine

# Only what the app actually needs. Nothing in composer.lock requires gd, zip, intl,
# exif, pcntl or bcmath. (mbstring, ctype, tokenizer, openssl, etc. are already built
# into the php image, and so is opcache.so - it only has to be enabled.)
#
# Alpine's default CDN (dl-cdn.alpinelinux.org) is slow from our server, so nginx and
# supervisor come from a nearer mirror; override with --build-arg APK_MIRROR=dl-cdn.alpinelinux.org.
# apk still verifies package signatures, so the mirror is not trusted blindly.
ARG APK_MIRROR=mirrors.aliyun.com
COPY docker/php/ext/pdo_mysql.so /tmp/pdo_mysql.so
RUN --mount=type=cache,target=/var/cache/apk \
    sed -i "s#dl-cdn.alpinelinux.org#${APK_MIRROR}#g" /etc/apk/repositories \
    && ln -sf /var/cache/apk /etc/apk/cache \
    && apk add nginx supervisor \
    && mv /tmp/pdo_mysql.so "$(php-config --extension-dir)/pdo_mysql.so" \
    && docker-php-ext-enable pdo_mysql opcache \
    && php -m | grep -qx pdo_mysql \
    && php -m | grep -qx 'Zend OPcache'

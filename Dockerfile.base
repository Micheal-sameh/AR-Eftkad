# syntax=docker/dockerfile:1

# Base image for the app: php-fpm + nginx + supervisor + pdo_mysql.
#
# This is split out of the main Dockerfile because compiling pdo_mysql needs a ~150 MB
# toolchain that took 10-25 minutes to download on our server. It only has to be built
# ONCE (compose does it automatically through the `base` service, and the result stays in
# the local image store), so the day-to-day app build never touches the toolchain.
# Rebuild it only when the PHP version below changes.

# ---- PHP extension: pdo_mysql ----
# Own stage so the toolchain never reaches the final image; only the compiled .so and its
# ini are copied across.
#
# Alpine's default CDN (dl-cdn.alpinelinux.org) only gives ~65 KB/s to our server, so apk
# uses a nearer mirror; override with --build-arg APK_MIRROR=dl-cdn.alpinelinux.org.
# apk still verifies package signatures, so the mirror is not trusted blindly.
FROM php:8.2.35-fpm-alpine AS ext
ARG APK_MIRROR=mirrors.aliyun.com
RUN --mount=type=cache,target=/var/cache/apk \
    sed -i "s#dl-cdn.alpinelinux.org#${APK_MIRROR}#g" /etc/apk/repositories \
    && ln -sf /var/cache/apk /etc/apk/cache \
    && apk add $PHPIZE_DEPS \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql

# ---- Runtime base ----
FROM php:8.2.35-fpm-alpine

# Only what the app actually needs. Nothing in composer.lock requires gd, zip, intl,
# exif, pcntl or bcmath. (mbstring, ctype, tokenizer, openssl, etc. are already built
# into the php image, and so is opcache.so - it only has to be enabled.)
ARG APK_MIRROR=mirrors.aliyun.com
RUN --mount=type=cache,target=/var/cache/apk \
    sed -i "s#dl-cdn.alpinelinux.org#${APK_MIRROR}#g" /etc/apk/repositories \
    && ln -sf /var/cache/apk /etc/apk/cache \
    && apk add nginx supervisor

COPY --from=ext /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=ext /usr/local/etc/php/conf.d/docker-php-ext-pdo_mysql.ini /usr/local/etc/php/conf.d/docker-php-ext-pdo_mysql.ini
RUN docker-php-ext-enable opcache \
    && php -m | grep -qx pdo_mysql \
    && php -m | grep -qx 'Zend OPcache'
